# ─── App ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql://projectquote:projectquote@localhost:5432/projectquote

# ─── Redis (queues) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (MinIO local / S3 prod) ──────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=projectquote
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── AI (MVP default: OpenAI) ────────────────────────
AI_PROVIDER=openai
# Use mock AI when OPENAI_API_KEY is empty
# AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Per-org monthly AI budget cap (USD cents); 0 = unlimited
AI_MONTHLY_BUDGET_CAP_CENTS=0

# ─── Email (optional MVP) ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@localhost

# ─── Defaults (org can override) ─────────────────────
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
DEFAULT_TAX_LABEL=GST

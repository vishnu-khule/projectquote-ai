generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  DRAFT
  DOCUMENT_PROCESSING
  ANALYZING
  WAITING_FOR_INFORMATION
  READY_FOR_ESTIMATION
  ESTIMATION_GENERATED
  VALIDATION
  PROPOSALS_GENERATED
  USER_REVIEW
  APPROVED
  PDF_GENERATED
  SHARED
  DOCUMENT_PROCESSING_FAILED
  AI_ANALYSIS_FAILED
  VALIDATION_FAILED
  PDF_GENERATION_FAILED
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  name         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  country            String               @default("IN")
  currency           String               @default("INR")
  defaultTaxPercent  String               @default("18")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  members   OrganizationMember[]
  projects       Project[]
  customers      Customer[]
  catalogItems   PriceCatalogItem[]
  invites        OrganizationInvite[]
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole      @default(MEMBER)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([tokenHash])
}

model PriceCatalogItem {
  id             String       @id @default(uuid())
  organizationId String
  sku            String
  name           String
  category       String
  kind           String       @default("material")
  unit           String
  unitPrice      String
  taxPercent     String       @default("18")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sku])
}

model ValidationResult {
  id         String   @id @default(uuid())
  projectId  String
  estimateId String?
  status     String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]
}

model Project {
  id                 String        @id @default(uuid())
  organizationId     String
  customerId         String?
  projectType        String
  title              String
  projectDescription String?
  location           String?
  status             ProjectStatus @default(DRAFT)
  requirements       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id])
  documents      Document[]
  estimates      Estimate[]
  proposals      Proposal[]
  aiConversation AiConversation?
  aiRuns         AiRun[]
}

model AiConversation {
  id        String      @id @default(uuid())
  projectId String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiRun {
  id            String   @id @default(uuid())
  projectId     String
  agent         String
  promptVersion String
  model         String
  status        String
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  output        Json?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  fileName  String
  mimeType  String
  s3Key     String
  status    String   @default("uploaded")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id         String                      @id @default(uuid())
  documentId String
  content    String
  metadata   Json                        @default("{}")
  embedding  Unsupported("vector(1536)")?
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Estimate {
  id        String         @id @default(uuid())
  projectId String
  version   Int
  tier      String         @default("single")
  totals    Json
  createdAt DateTime       @default(now())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     EstimateItem[]
}

model EstimateItem {
  id              String  @id @default(uuid())
  estimateId      String
  name            String
  category        String
  quantity        String
  unit            String
  unitPrice       String
  labourHours     String?
  labourRate      String?
  discountPercent String  @default("0")
  taxPercent      String  @default("0")
  priceSource     String
  confirmed       Boolean @default(false)
  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model Proposal {
  id               String    @id @default(uuid())
  projectId        String
  estimateId       String?
  title            String?
  version          Int
  tier             String
  sections         Json
  status           String    @default("draft")
  approvedAt       DateTime?
  approvedByUserId String?
  pdfS3Key         String?
  createdAt        DateTime  @default(now())
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shares           Share[]
}

model Share {
  id         String    @id @default(uuid())
  proposalId String
  tokenHash  String    @unique
  expiresAt  DateTime?
  revokedAt  DateTime?
  events     Json      @default("[]")
  createdAt  DateTime  @default(now())
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

{
  "name": "projectquote-ai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @projectquote/api db:generate",
    "db:migrate": "pnpm --filter @projectquote/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @projectquote/api db:migrate:deploy",
    "db:studio": "pnpm --filter @projectquote/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
